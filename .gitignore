.env
.venv/
__pycache__/

# Credenciais do YouTube (OAuth) — NUNCA versionar
client_secret*.json
.youtube_token.json

# Mini-fluxo de Reels: artefatos gerados (mantém cenas.json e prompt_imagens.txt)
reels/projetos/*/audio/
reels/projetos/*/clips/
reels/projetos/*/captions/
reels/projetos/*/imagens/
reels/projetos/*/reel.mp4
reels/projetos/*/captions.srt

# Referências virais: conteúdo de terceiros baixado (capas, transcrições cruas, vídeos).
# Mantém só os .md curados (referencias_nicho.md, analise_viral.md, README.md).
referencias/capas/
referencias/transcricoes/
referencias/videos/

# Voz do canal: sua amostra gravada e as falas geradas. Dados pessoais (sua voz): nunca versionar.
voz/*.wav
voz/*.mp3
voz/*.m4a
output/*/falas/

# produtividade: estado local dos avisos
produtividade/.estado_avisos.json
produtividade/.ronaldo*
produtividade/.feitos.json
produtividade/.trello_quadro.json
produtividade/.kanban.bak.md
produtividade/.google_pessoal_token.json
produtividade/.google_agenda_estado.json
# produtividade: dados pessoais (agenda, lembretes, tarefas, horas, acessos, Kanban, posts)
produtividade/agenda.json
produtividade/agenda.md
produtividade/lembretes.json
produtividade/tarefas.md
produtividade/horas.md
produtividade/acessos.md
produtividade/kanban.md
produtividade/linkedin/
.google_pessoal_token.json
financas/planilha/
